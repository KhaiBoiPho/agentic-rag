# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── gRPC ───────────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_secret
DATABASE_URL=postgresql+asyncpg://agentic:agentic_secret@localhost:5432/agentic_rag

# ─── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false          # true for Qdrant Cloud (requires TLS)
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agentic_rag_chunks

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# OAuth2 — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ─── OpenRouter ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Production chat model. A request that sends no `model` resolves here.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
# Do NOT change without re-indexing: every stored vector is 1024-dim from this
# model, and a different embedder makes the whole Qdrant collection unusable.
OPENROUTER_EMBED_MODEL=voyageai/voyage-4-large
OPENROUTER_RESEARCH_MODEL=google/gemini-2.5-flash
# Cheap/fast model for the off-topic guard, follow-up condensing and the
# request-route classifier — deliberately independent of the chat model.
OPENROUTER_CLASSIFIER_MODEL=openai/gpt-4o-mini
# Two different vendors on purpose (see app/config.py) — a model can invent a
# table cell, and a second opinion from the same model repeats the invention.
OPENROUTER_VISION_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_VISION_TABLE_MODEL=google/gemini-2.5-flash

# ─── OpenAI (TTS only — direct API, not via OpenRouter) ──────────────────────
# OpenRouter has no real /audio/speech endpoint — this is a genuine OpenAI key.
OPENAI_API_KEY=sk-...
OPENAI_TTS_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=tts-1

# ─── STT ─────────────────────────────────────────────────────────────────────
# local = in-process faster-whisper (needs a CUDA host for anything bigger than "base")
# http  = your own GPU box + tunnel (ngrok etc.), see local-gpu-stt/ (no cold start, box must be on)
STT_BACKEND=local
STT_HTTP_URL=
STT_HTTP_SECRET=

# Only used when STT_BACKEND=local
# WHISPER_MODEL_SIZE also accepts phowhisper-tiny/base/small/medium/large
# (VinAI's Vietnamese fine-tune, auto-downloaded as CTranslate2 — see
# app/core/voice/phowhisper.py) instead of plain Whisper sizes.
# phowhisper-medium is the current recommended default for Vietnamese
# accuracy on CPU; phowhisper-large is more accurate still but noticeably
# slower without a GPU.
WHISPER_MODEL_SIZE=phowhisper-medium
WHISPER_DEVICE=cpu              # cpu | cuda — switch when GPU infra is available
WHISPER_COMPUTE_TYPE=int8       # int8 for cpu; use float16 with cuda

# ─── Firecrawl ───────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ─── Deep Research ───────────────────────────────────────────────────────────
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SEARCH_RESULTS=10
RESEARCH_QUALITY_THRESHOLD=0.75

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_TOKEN_NUM=512
CHUNK_OVERLAP_PERCENT=15
TABLE_CONTEXT_SIZE=128
CHUNK_DELIMITER="\n!?。；！？"

# ─── Embedding ───────────────────────────────────────────────────────────────
EMBED_BATCH_SIZE=32
EMBED_DIM=1024

# ─── Hybrid retrieval (dense + BM25, fused with RRF k=60) ────────────────────
# BM25 length normalisation needs a corpus average, baked in at INDEX time.
# 600 is an ESTIMATE — run `python -m scripts.backfill_sparse_vectors` and set
# this to the true average it prints, then re-run it with --apply.
BM25_AVG_DOC_LEN=600
# BM25 may reorder/extend what dense retrieval found, but not answer alone.
# false = reproduce the benchmark's ungated fusion exactly.
HYBRID_REQUIRE_DENSE_SUPPORT=true

# ─── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3210"]
