# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── gRPC ───────────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_secret
DATABASE_URL=postgresql+asyncpg://agentic:agentic_secret@localhost:5432/agentic_rag

# ─── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false          # true for Qdrant Cloud (requires TLS)
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agentic_rag_chunks

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# OAuth2 — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ─── OpenRouter ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_RESEARCH_MODEL=openai/gpt-4o-mini
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# ─── STT ─────────────────────────────────────────────────────────────────────
STT_BACKEND=local               # local | runpod — runpod = GPU via RunPod Serverless, see runpod/whisper-stt/
RUNPOD_API_KEY=
RUNPOD_STT_ENDPOINT_ID=
RUNPOD_BASE_URL=https://api.runpod.ai/v2

# Only used when STT_BACKEND=local
WHISPER_MODEL_SIZE=base         # base is un-fine-tuned for now — swap when ready
WHISPER_DEVICE=cpu              # cpu | cuda — switch when GPU infra is available
WHISPER_COMPUTE_TYPE=int8       # int8 for cpu; use float16 with cuda

# ─── Firecrawl ───────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ─── Deep Research ───────────────────────────────────────────────────────────
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SEARCH_RESULTS=10
RESEARCH_QUALITY_THRESHOLD=0.75

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_TOKEN_NUM=512
CHUNK_OVERLAP_PERCENT=15
TABLE_CONTEXT_SIZE=128
CHUNK_DELIMITER="\n!?。；！？"

# ─── Embedding ───────────────────────────────────────────────────────────────
EMBED_BATCH_SIZE=32
EMBED_DIM=1536

# ─── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3210"]
