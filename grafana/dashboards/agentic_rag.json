{
  "title": "Agentic RAG — Overview",
  "uid": "agentic-rag-overview",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "HTTP Requests / min",
      "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [{"expr": "rate(http_requests_total[1m])*60", "legendFormat": "req/min"}]
    },
    {
      "id": 2, "type": "stat", "title": "gRPC Requests / min",
      "gridPos": {"x":6,"y":0,"w":6,"h":4},
      "targets": [{"expr": "rate(grpc_requests_total[1m])*60", "legendFormat": "req/min"}]
    },
    {
      "id": 3, "type": "stat", "title": "Chunks Indexed (total)",
      "gridPos": {"x":12,"y":0,"w":6,"h":4},
      "targets": [{"expr": "ingestion_chunks_total", "legendFormat": "chunks"}]
    },
    {
      "id": 4, "type": "stat", "title": "Active gRPC Streams",
      "gridPos": {"x":18,"y":0,"w":6,"h":4},
      "targets": [{"expr": "active_grpc_streams", "legendFormat": "streams"}]
    },
    {
      "id": 5, "type": "graph", "title": "HTTP Latency (p50/p95/p99)",
      "gridPos": {"x":0,"y":4,"w":12,"h":8},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 6, "type": "graph", "title": "LLM Request Latency by Model",
      "gridPos": {"x":12,"y":4,"w":12,"h":8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(llm_request_duration_seconds_bucket[5m])) by (model)", "legendFormat": "{{model}} p95"}
      ]
    },
    {
      "id": 7, "type": "graph", "title": "LLM Tokens / min",
      "gridPos": {"x":0,"y":12,"w":12,"h":8},
      "targets": [
        {"expr": "rate(llm_tokens_total[1m])*60", "legendFormat": "{{model}} {{direction}}"}
      ]
    },
    {
      "id": 8, "type": "graph", "title": "Ingestion Duration",
      "gridPos": {"x":12,"y":12,"w":12,"h":8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(ingestion_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.50, rate(ingestion_duration_seconds_bucket[5m]))", "legendFormat": "p50"}
      ]
    }
  ]
}
