# ─── Secrets & local config ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Frontend (Node/Next.js) ─────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.claude/
.idea/
.DS_Store
Thumbs.db

# ─── Local data (not committed — see docs for how to obtain/generate) ───────
*.db
*.sqlite3

# ─── Postgres/Qdrant volume backups (see docs/getting-started.md §9) ────────
# Large binary DB/vector dumps used to skip re-seeding+re-embedding
# seed_data/ on a new machine/engine — never commit, restore locally instead.
backups/*.tar.gz

# Vector embedding cache cho benchmark (tái dùng giữa các lần chạy, rất nặng)
.bench_cache/

# Merged/converted STT models (local-gpu-stt/merge_lora.py output) — a few
# GB each, machine-local, regenerated on demand from the HF repos.
local-gpu-stt/*-merged/
local-gpu-stt/*-ct2/
